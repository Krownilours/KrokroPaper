-                        if (event.getItem().equals(oitemstack) && itemstack1 == null) {
-                            // CraftBukkit end
+                        itemstack1 = TileEntityHopper.addItem(iinventory, CraftItemStack.asNMSCopy(oitemstack), enumdirection.opposite());
+                        if (itemstack1 == null) {
                             itemstack1 = itemstack.cloneItemStack();
